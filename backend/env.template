# ClipFinder MVP - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/clipfinder

# ============================================
# AUTHENTICATION
# ============================================
# JWT secret key - generate with: openssl rand -hex 32
JWT_SECRET=your-random-256-bit-secret-here

# Google OAuth2 credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Set authorized redirect URI to: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Picker API Key
# Create an API key in Cloud Console with Google Picker API enabled
# https://console.cloud.google.com/apis/credentials → Create Credentials → API Key
GOOGLE_API_KEY=your-api-key

# ============================================
# APPLICATION URLS
# ============================================
# Dev (local) and prod URLs; set APP_URL and FRONTEND_URL to the pair you want to use.
APP_URL_DEV=http://localhost:8000
FRONTEND_URL_DEV=http://localhost:3000
APP_URL_PROD=https://your-app.azurecontainerapps.io
FRONTEND_URL_PROD=https://your-app.azurecontainerapps.io
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ============================================
# PAYMENTS (Optional for MVP)
# ============================================
# Stripe test mode key
STRIPE_TEST_KEY=sk_test_...

# ============================================
# CACHE & QUEUE (Optional)
# ============================================
# Redis URL for Celery task queue
REDIS_URL=redis://localhost:6379

# ============================================
# ANALYTICS (Optional)
# ============================================
# PostHog API key for event tracking
POSTHOG_API_KEY=your-posthog-key

# ============================================
# LANGFUSE (Optional - tracing embeddings & retrieval)
# ============================================
# Get keys from https://cloud.langfuse.com or your self-hosted instance
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================
# GEMINI EMBEDDING 2 (for vision/image embeddings)
# ============================================
# Get API key from https://aistudio.google.com/apikey
# Docs: https://ai.google.dev/gemini-api/docs/embeddings
GEMINI_API_KEY=your-gemini-api-key
# Or use GOOGLE_AI_VISION_API_KEY (alias supported for backward compatibility)
# GOOGLE_AI_VISION_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# ============================================
# SUPABASE (for video frame image storage)
# ============================================
# Required for per-frame video indexing: frame images are uploaded to this bucket.
# Create a public bucket (e.g. "video-frames") in Supabase Storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=video-frames

# ============================================
# AZURE SERVICE BUS (required for indexing)
# ============================================
# Create a namespace with two queues: frame-indexing and image-indexing.
# Deploy Azure Functions consumers (see functions/) to process messages.
SERVICE_BUS_SAS_PRIMARY_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
VIDEO_INDEXING_QUEUE=frame-indexing
IMAGE_INDEXING_QUEUE=image-indexing

# ============================================
# VIDEO FRAME INDEXING
# ============================================
# ffmpeg must be installed and on PATH for video frame extraction (every 5th frame).
# FRAME_INDEX_PARALLELISM=8

# ============================================
# TRANSCRIPTION (WhisperX, word-level timestamps)
# ============================================
# Videos are transcribed locally during indexing (WhisperX ASR + forced alignment);
# segments (text + segment/word timestamps) are stored for lexical and semantic
# transcript search.
# TRANSCRIPTION_ENABLED=true
# WHISPER_MODEL_SIZE=tiny

# ============================================
# REMOTE MCP SERVER (streamable HTTP at /mcp)
# ============================================
# Connect from claude.ai to {APP_URL}/mcp/ (trailing slash). Users sign in via
# WorkOS AuthKit (Google). Claude Advanced client id/secret are optional:
# leave both empty for public PKCE; set both for a confidential connector.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Email for HTTP POST /reels/ingest only (not used by MCP tools after WorkOS).
MCP_USER_EMAIL=
# Azure Blob container where downloaded Instagram reel videos are stored.
AZURE_BLOB_VIDEOS_CONTAINER=instagram-videos
# Reject reels longer than this (caps Gemini embedding cost per reel).
MCP_MAX_REEL_SECONDS=180

# ============================================
# WORKOS AUTHKIT (MCP Google social login)
# ============================================
# Staging keys for localhost; Production keys for Azure. See Start.md.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Defaults to {APP_URL}/mcp-oauth/workos/callback when unset.
# If you set this on Azure/PowerShell, use forward slashes only (not Windows path separators).
WORKOS_REDIRECT_URI=
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

